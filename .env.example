# Copy to .env.local (gitignored) and fill in. .env.development / .env.production also work.
CONTENTFUL_SPACE_ID=
# Delivery API token (published content). Used by `npm run build`.
CONTENTFUL_ACCESS_TOKEN=
# Optional: Preview API token. When set, `npm run dev` shows draft entries too.
CONTENTFUL_PREVIEW_TOKEN=
# Optional: defaults to master.
CONTENTFUL_ENVIRONMENT=
# Only for `npm run migrate`. Prefer passing it inline instead of saving it here.
CONTENTFUL_MANAGEMENT_TOKEN=
